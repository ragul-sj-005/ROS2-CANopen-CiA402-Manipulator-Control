<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="standalone_manipulator">

  <!-- ========================================================= -->
  <!-- Materials                                                 -->
  <!-- ========================================================= -->

  <material name="grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>


  <!-- ========================================================= -->
  <!-- Stand / Base                                              -->
  <!-- ========================================================= -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.05"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.025"/>
      <mass value="0.5"/>
      <inertia
        ixx="0.001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.001"
        iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>


  <!-- Fixed connection from our stand to OpenMANIPULATOR-X -->

  <joint name="base_to_link1" type="fixed">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>


  <!-- ========================================================= -->
  <!-- OpenMANIPULATOR-X                                         -->
  <!-- ========================================================= -->

  <xacro:include
    filename="/opt/ros/humble/share/turtlebot3_manipulation_gazebo/urdf/open_manipulator_x.urdf.xacro"/>

  <xacro:open_manipulator_x prefix=""/>


  <!-- ========================================================= -->
  <!-- Gazebo                                                    -->
  <!-- ========================================================= -->

  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <ros2_control name="StandaloneManipulatorSystem" type="system">

    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="gripper_left_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find standalone_manipulator)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
